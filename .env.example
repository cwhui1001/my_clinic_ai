# Public Supabase values. These are safe to expose to the browser and are
# available from the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase secret. Never prefix this with NEXT_PUBLIC_ and never
# expose it to browser code. Use the current Supabase secret key when available.
SUPABASE_SECRET_KEY=your-secret-key

# Application settings.
NEXT_PUBLIC_DEFAULT_CLINIC_SLUG=nightingale-demo
LEAD_SESSION_TTL_DAYS=7

# Generate independent random values for these secrets. Each value must be at
# least 32 characters. The context encryption key must be base64-encoded 32 bytes.
LEAD_CONTEXT_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
RATE_LIMIT_HMAC_KEY=replace-with-a-random-string-of-at-least-32-characters

# Phase 2 guest chat. These values are server-only. The Responses API request
# uses store=false and receives redacted text only.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_REQUEST_TIMEOUT_MS=15000

# Optional executable PWA Web Push transport. Generate a VAPID pair with:
# npx web-push generate-vapid-keys
# Leave all three blank to disable device alerts without making delivery promises.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-operator-email@example.com

# Tests that create and remove synthetic hosted Supabase fixtures are opt-in.
# Keep disabled for the normal local suite and never enable against production.
RUN_HOSTED_BOUNDARY_TESTS=0
RUN_HOSTED_TENANT_TESTS=0
