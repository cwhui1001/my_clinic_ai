# Public Supabase values. These are safe to expose to the browser and are
# available from the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase secret. Never prefix this with NEXT_PUBLIC_ and never
# expose it to browser code. Use the current Supabase secret key when available.
SUPABASE_SECRET_KEY=your-secret-key

# Phase 1 application settings.
NEXT_PUBLIC_DEFAULT_CLINIC_SLUG=nightingale-demo
LEAD_SESSION_TTL_DAYS=7

# Generate independent random values for these secrets. Each value must be at
# least 32 characters. The context encryption key must be base64-encoded 32 bytes.
LEAD_CONTEXT_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
RATE_LIMIT_HMAC_KEY=replace-with-a-random-string-of-at-least-32-characters
